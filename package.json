{
  "name": "dualcore-vm",
  "version": "1.1.0",
  "description": "Portable QEMU virtual machine manager for Windows 10 and 11",
  "main": "src/main/main.js",
  "author": "DualCore VM",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.dualcore.vm",
    "productName": "DualCore VM",
    "win": {
      "target": ["portable"]
    },
    "artifactName": "DualCore-VM-${version}-Windows-Portable.${ext}"
  }
}